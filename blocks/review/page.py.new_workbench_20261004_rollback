      var f = document.getElementById('wb-doc');
      var fe = document.getElementById('wb-doc-empty');
      if (f) {{ f.src = '/applications/{app_id}/doc/' + t.dataset.tpl + '/html'; }}
      if (fe) {{ fe.style.display = 'none'; }}
    }}
  }}, true);
  var up = document.getElementById('wb-upload');
  if (up) {{
    up.addEventListener('click', function () {{
      if (!up.disabled) {{ alert('Выгрузка на Google Диск: функция в разработке — нужна загрузка в gdrive_api.'); }}
    }});
  }}
  var vc = document.getElementById('wb-vars-collapse');
  if (vc) {{
    vc.addEventListener('click', function () {{
      var a = document.getElementById('rv-collapse-all');
      if (a) {{ a.click(); }}
    }});
  }}
  /* Этапы-кнопки: пока идёт работа — бегут полоски, когда готово — зелёный. */
  (function bindTiles() {{
    var tiles = [['rv-scan', 'wb-note-1', 'идёт выгрузка', 'готово'],
                 ['wb-tile-2', 'wb-note-2', null, 'готово'],
                 ['rv-autofill', 'wb-note-3', 'идёт заполнение', 'готово']];
    tiles.forEach(function (spec) {{
      var b = document.getElementById(spec[0]), note = document.getElementById(spec[1]);
      if (!b) {{ return; }}
      b.addEventListener('click', function () {{
        if (b.id !== 'wb-tile-2') {{ b.classList.add('is-run'); if (note && spec[2]) {{ note.textContent = spec[2]; }} }}
      }});
      new MutationObserver(function () {{
        if (b.dataset.done === '1') {{
          b.classList.remove('is-run'); b.classList.add('is-done');
          if (note) {{ note.textContent = spec[3]; }}
        }}
      }}).observe(b, {{ attributes: true, attributeFilter: ['data-done', 'class'] }});
    }});
  }})();
  /* Левое окно: показываем скан клиента простой картинкой (лёгкий каркас,
     движок зума подключим отдельно, чтобы страница не тормозила). */
  function showScan(tile) {{
    var img = document.getElementById('wb-scan-img');
    var emp = document.getElementById('wb-scan-empty');
    if (!img || !tile) {{ return; }}
    var page = tile.dataset.page || '';
    var name = tile.dataset.file || '';
    var big = page || ('/applications/{app_id}/file?name=' + encodeURIComponent(name) + '&w=1400');
    img.src = big;
    img.style.display = 'block';
    if (emp) {{ emp.style.display = 'none'; }}
  }}
  document.addEventListener('click', function (e) {{
    var t = e.target && e.target.closest ? e.target.closest('.wb-rail-l .rv-thumb') : null;
    if (t) {{ showScan(t); }}
  }}, true);
  /* Этап 1 «Выгрузка с Google Диска»: пока грузятся миниатюры клиента, этап
     мигает и пишет, сколько уже выгружено; когда всё загрузилось — галочка.
     Сам визор и наши бланки подключаются после этого, чтобы разметка и поля
     показывались сразу. */
  (function stageOne() {{
    var tile1 = document.getElementById('rv-scan');
    var note = document.getElementById('wb-note-1');
    var tiles = document.querySelectorAll('.wb-rail-l .rv-thumb img');
    if (!tiles.length) {{ return; }}
    var total = tiles.length, done = 0;
    if (tile1) {{ tile1.classList.add('is-run'); }}
    function tick() {{
      done++;
      if (note) {{
        note.textContent = done >= total ? ('выгружено: ' + total)
                                         : ('идёт выгрузка: ' + done + ' из ' + total);
      }}
      if (done >= total && tile1) {{
        tile1.classList.remove('is-run');
        tile1.classList.add('is-done');
        var t2 = document.getElementById('wb-tile-2');
        var n2 = document.getElementById('wb-note-2');
        if (t2) {{ t2.classList.add('is-cur'); }}
        if (n2) {{ n2.textContent = 'можно распознавать'; }}
        /* Наши бланки подключаем только теперь: сначала разметка и документы
           клиента, потом правая сторона. Так страница не ждёт всё сразу. */
        var fd = document.getElementById('wb-doc');
        var fde = document.getElementById('wb-doc-empty');
        var onT = document.querySelector('.wb-rail-r .rv-thumb.is-on') ||
                  document.querySelector('.wb-rail-r .rv-thumb[data-tpl]');
        if (fd && !fd.getAttribute('src') && onT) {{
          fd.src = '/applications/{app_id}/doc/' + onT.dataset.tpl + '/html';
          if (fde) {{ fde.style.display = 'none'; }}
        }}
      }}
    }}
    for (var i = 0; i < tiles.length; i++) {{
      var im = tiles[i];
      if (!im.getAttribute('src') && im.dataset.src) {{ im.src = im.dataset.src; }}
      if (im.complete && im.naturalWidth) {{ tick(); }}
      else {{ im.addEventListener('load', tick); im.addEventListener('error', tick); }}
    }}
  }})();
  /* Переменные зависят от открытого документа: щёлкнули наш бланк — в центре
     остаются его поля, щёлкнули скан клиента — снова все поля заявки. */
  function wbFilterVars(tpl, title) {{
    var fields = document.querySelectorAll('.wb-vars .rv-field');
    var shown = 0;
    for (var i = 0; i < fields.length; i++) {{
      var list = (fields[i].dataset.tpls || '').split(',');
      var ok = !tpl || list.indexOf(String(tpl)) >= 0;
      fields[i].style.display = ok ? '' : 'none';
      if (ok) {{ shown++; }}
    }}
    var blks = document.querySelectorAll('.wb-vars .rv-blk');
    for (var b = 0; b < blks.length; b++) {{
      var body = blks[b].querySelector('.rv-blk-body');
      var vis = body ? body.querySelectorAll('.rv-field').length : 0;
      var real = 0;
      if (body) {{
        var ff = body.querySelectorAll('.rv-field');
        for (var k = 0; k < ff.length; k++) {{ if (ff[k].style.display !== 'none') {{ real++; }} }}
      }}
      blks[b].style.display = real ? '' : 'none';
      var n = blks[b].querySelector('.rv-blk-n');
      if (n) {{ n.textContent = real; }}
      if (vis === 0) {{ blks[b].style.display = 'none'; }}
    }}
    var cap = document.getElementById('wb-vars-scope');
    if (cap) {{ cap.textContent = title ? ('документ: ' + title) : 'вся заявка'; }}
    var cnt = document.getElementById('wb-vars-cnt');
    if (cnt) {{ cnt.textContent = shown; }}
  }}
  document.addEventListener('click', function (e) {{
    if (!e.target || !e.target.closest) {{ return; }}
    var t = e.target.closest('.rv-thumb[data-tpl]');
    if (t) {{
      var nm = t.querySelector('.rv-thumb-name');
      wbFilterVars(t.dataset.tpl, nm ? nm.textContent.trim() : '');
      return;
    }}
    if (e.target.closest('.wb-rail-l .rv-thumb')) {{ wbFilterVars('', ''); }}
  }}, true);
  /* При открытии заявки сразу наполняем оба окна и показываем переменные
     первого документа — чтобы было видно: окон два, слева клиент, справа наши. */
  setTimeout(function () {{
    var on = document.querySelector('.wb-rail-r .rv-thumb.is-on') ||
             document.querySelector('.wb-rail-r .rv-thumb[data-tpl]');
    if (on) {{
      var nm = on.querySelector('.rv-thumb-name');
      wbFilterVars(on.dataset.tpl, nm ? nm.textContent.trim() : '');
      var f = document.getElementById('wb-doc');
      var fe = document.getElementById('wb-doc-empty');
      if (f && !f.getAttribute('src')) {{
        f.src = '/applications/{app_id}/doc/' + on.dataset.tpl + '/html';
        if (fe) {{ fe.style.display = 'none'; }}
      }}
    }}
    /* Автопоказ первого скана — БЕЗ нажатия на плитку: нажатие открывало
       тяжёлое окно-модалку с движком зума, и страница подвисала. Здесь просто
       показываем картинку в левом окне. */
    var sc = document.querySelector('.wb-rail-l .rv-thumb');
    if (sc) {{ showScan(sc); }}
  }}, 1000);
}})();
</script>
