            if any(g["name"] == _orig for g in files):
                derived.add(f["name"])
    files = [f for f in files if f["name"] not in derived]

    def _preview_of(name: str, ext: str) -> str:
        if ext in (".png", ".jpg", ".jpeg", ".webp", ".gif"):
            # Миниатюра — уменьшенная копия (5 КБ вместо 5 МБ) и грузится сразу,
            # нативно браузером: раньше её подставлял скрипт, и до его срабатывания
            # на плитке висело колёсико загрузки.
