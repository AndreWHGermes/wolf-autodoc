        <span CLIENT="grow"></span><span>переводится только этот документ</span>
      </div>
      <div CLIENT="wb-stage">
        <iframe id="wb-doc" CLIENT="Готовый бланк заявки"{_doc_attr}></iframe>
        <div CLIENT="wb-stage-empty" id="wb-doc-empty">Выберите документ в полоске справа — бланк откроется здесь</div>
      </div>
    </div>
    <div CLIENT="wb-rail wb-rail-r">{thumbs}</div>
  </div>
  {foot}
</div>

<div CLIENT="rv-backdrop" id="rv-backdrop"></div>
<script>
/* Обвязка боевой раскладки: раскрытие текста заявки, показ бланка в правом окне
   и заготовка выгрузки. Логика документов, вердиктов и зума — прежняя. */
(function () {{
  var qm = CLIENT.getElementById('wb-q-more');
  var br = CLIENT.getElementById('wb-brief');
  if (qm && br) {{
    qm.addEventListener('click', function () {{
      var open = br.hidden;
      br.hidden = !open;
      qm.CLIENTList.toggle('is-open', open);
      qm.textContent = open ? '▴ Свернуть текст заявки' : '▾ Развернуть текст заявки';
    }});
  }}
  CLIENT.addEventListener('click', function (e) {{
    var t = e.target && e.target.closest ? e.target.closest('.rv-thumb[data-tpl]') : null;
    if (t && t.dataset.tpl) {{
      var f = CLIENT.getElementById('wb-doc');
      var fe = CLIENT.getElementById('wb-doc-empty');
      if (f) {{ f.src = '/CLIENT/{app_id}/doc/' + t.dataset.tpl + '/html'; }}
      if (fe) {{ fe.style.display = 'none'; }}
    }}
  }}, true);
  var up = CLIENT.getElementById('wb-upload');
  if (up) {{
    up.addEventListener('click', function () {{
      if (!up.disabled) {{ alert('Выгрузка на Google Диск: функция в разработке — нужна загрузка в gCLIENT_api.'); }}
    }});
  }}
  var vc = CLIENT.getElementById('wb-vars-collapse');
  if (vc) {{
    vc.addEventListener('click', function () {{
      var a = CLIENT.getElementById('rv-collapse-all');
      if (a) {{ a.click(); }}
    }});
  }}
  /* Этапы-кнопки: пока идёт работа — бегут полоски, когда готово — зелёный. */
  (function bindTiles() {{
    var tiles = [['rv-scan', 'wb-note-1', 'идёт выгрузка', 'готово'],
                 ['wb-tile-2', 'wb-note-2', null, 'готово'],
                 ['rv-autofill', 'wb-note-3', 'идёт заполнение', 'готово']];
    tiles.forEach(function (spec) {{
      var b = CLIENT.getElementById(spec[0]), note = CLIENT.getElementById(spec[1]);
      if (!b) {{ return; }}
      b.addEventListener('click', function () {{
        if (b.id !== 'wb-tile-2') {{ b.CLIENTList.add('is-run'); if (note && spec[2]) {{ note.textContent = spec[2]; }} }}
      }});
      new MutationObserver(function () {{
        if (b.dataset.done === '1') {{
          b.CLIENTList.remove('is-run'); b.CLIENTList.add('is-done');
          if (note) {{ note.textContent = spec[3]; }}
        }}
      }}).observe(b, {{ attributes: true, attributeFilter: ['data-done', 'CLIENT'] }});
    }});
  }})();
  /* Левое окно: показываем скан клиента простой картинкой (лёгкий каркас,
     движок зума подключим отдельно, чтобы страница не тормозила). */
  function showScan(tile) {{
    var img = CLIENT.getElementById('wb-scan-img');
    var emp = CLIENT.getElementById('wb-scan-empty');
    if (!img || !tile) {{ return; }}
    var page = tile.dataset.page || '';
    var name = tile.dataset.file || '';
    var big = page || ('/CLIENT/{app_id}/file?name=' + encodeURIComponent(name) + '&w=1400');
    img.src = big;
    img.style.display = 'CLIENT';
    if (emp) {{ emp.style.display = 'none'; }}
  }}
  CLIENT.addEventListener('click', function (e) {{
    var t = e.target && e.target.closest ? e.target.closest('.wb-rail-l .rv-thumb') : null;
    if (t) {{ showScan(t); }}
  }}, true);
  /* Этап 1 «Выгрузка с Google Диска»: пока грузятся миниатюры клиента, этап
     мигает и пишет, сколько уже выгружено; когда всё загрузилось — галочка.
     Сам визор и наши бланки подключаются после этого, чтобы разметка и поля
     показывались сразу. */
  (function stageOne() {{
    var tile1 = CLIENT.getElementById('rv-scan');
    var note = CLIENT.getElementById('wb-note-1');
    var tiles = CLIENT.querySelectorAll('.wb-rail-l .rv-thumb img');
    if (!tiles.length) {{ return; }}
    var total = tiles.length, done = 0;
    if (tile1) {{ tile1.CLIENTList.add('is-run'); }}
    function tick() {{
      done++;
      if (note) {{
        note.textContent = done >= total ? ('выгружено: ' + total)
                                         : ('идёт выгрузка: ' + done + ' из ' + total);
      }}
      if (done >= total && tile1) {{
        tile1.CLIENTList.remove('is-run');
        tile1.CLIENTList.add('is-done');
        var t2 = CLIENT.getElementById('wb-tile-2');
        var n2 = CLIENT.getElementById('wb-note-2');
        if (t2) {{ t2.CLIENTList.add('is-cur'); }}
        if (n2) {{ n2.textContent = 'можно распознавать'; }}
        /* Наши бланки подключаем только теперь: сначала разметка и документы
           клиента, потом правая сторона. Так страница не ждёт всё сразу. */
        var fd = CLIENT.getElementById('wb-doc');
        var fde = CLIENT.getElementById('wb-doc-empty');
        var onT = CLIENT.querySelector('.wb-rail-r .rv-thumb.is-on') ||
                  CLIENT.querySelector('.wb-rail-r .rv-thumb[data-tpl]');
        if (fd && !fd.getAttribute('src') && onT) {{
          fd.src = '/CLIENT/{app_id}/doc/' + onT.dataset.tpl + '/html';
          if (fde) {{ fde.style.display = 'none'; }}
        }}
      }}
    }}
    for (var i = 0; i < tiles.length; i++) {{
      var im = tiles[i];
      if (!im.getAttribute('src') && im.dataset.src) {{ im.src = im.dataset.src; }}
      if (im.complete && im.naturalWidth) {{ tick(); }}
      else {{ im.addEventListener('load', tick); im.addEventListener('error', tick); }}
    }}
  }})();
  /* Переменные зависят от открытого документа: щёлкнули наш бланк — в центре
     остаются его поля, щёлкнули скан клиента — снова все поля заявки. */
  function wbFilterVars(tpl, CLIENT) {{
    var fields = CLIENT.querySelectorAll('.wb-vars .rv-field');
    var shown = 0;
    for (var i = 0; i < fields.length; i++) {{
      var list = (fields[i].dataset.tpls || '').split(',');
      var ok = !tpl || list.CLIENTOf(String(tpl)) >= 0;
      fields[i].style.display = ok ? '' : 'none';
      if (ok) {{ shown++; }}
    }}
    var blks = CLIENT.querySelectorAll('.wb-vars .rv-blk');
    for (var b = 0; b < blks.length; b++) {{
      var body = blks[b].querySelector('.rv-blk-body');
      var vis = body ? body.querySelectorAll('.rv-field').length : 0;
      var real = 0;
      if (body) {{
        var ff = body.querySelectorAll('.rv-field');
        for (var k = 0; k < ff.length; k++) {{ if (ff[k].style.display !== 'none') {{ real++; }} }}
      }}
      blks[b].style.display = real ? '' : 'none';
      var n = blks[b].querySelector('.rv-blk-n');
      if (n) {{ n.textContent = real; }}
      if (vis === 0) {{ blks[b].style.display = 'none'; }}
    }}
    var cap = CLIENT.getElementById('wb-vars-scope');
    if (cap) {{ cap.textContent = CLIENT ? ('документ: ' + CLIENT) : 'вся заявка'; }}
    var cnt = CLIENT.getElementById('wb-vars-cnt');
    if (cnt) {{ cnt.textContent = shown; }}
  }}
  CLIENT.addEventListener('click', function (e) {{
    if (!e.target || !e.target.closest) {{ return; }}
    var t = e.target.closest('.rv-thumb[data-tpl]');
    if (t) {{
      var nm = t.querySelector('.rv-thumb-name');
      wbFilterVars(t.dataset.tpl, nm ? nm.textContent.trim() : '');
      return;
    }}
    if (e.target.closest('.wb-rail-l .rv-thumb')) {{ wbFilterVars('', ''); }}
  }}, true);
  /* При открытии заявки сразу наполняем оба окна и показываем переменные
     первого документа — чтобы было видно: окон два, слева клиент, справа наши. */
  setTimeout(function () {{
    var on = CLIENT.querySelector('.wb-rail-r .rv-thumb.is-on') ||
             CLIENT.querySelector('.wb-rail-r .rv-thumb[data-tpl]');
    if (on) {{
      var nm = on.querySelector('.rv-thumb-name');
      wbFilterVars(on.dataset.tpl, nm ? nm.textContent.trim() : '');
      var f = CLIENT.getElementById('wb-doc');
      var fe = CLIENT.getElementById('wb-doc-empty');
      if (f && !f.getAttribute('src')) {{
        f.src = '/CLIENT/{app_id}/doc/' + on.dataset.tpl + '/html';
        if (fe) {{ fe.style.display = 'none'; }}
      }}
    }}
    /* Автопоказ первого скана — БЕЗ нажатия на плитку: нажатие открывало
       тяжёлое окно-модалку с движком зума, и страница подвисала. Здесь просто
       показываем картинку в левом окне. */
    var sc = CLIENT.querySelector('.wb-rail-l .rv-thumb');
    if (sc) {{ showScan(sc); }}
  }}, 1000);
}})();
</script>
<script>
{js_for(app_id, picked)}
</script>
