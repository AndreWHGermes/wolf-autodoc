          and (st.get("done") or 0) >= (st.get("total") or 0))
    return jsonify({"status": st.get("status") or "none", "done": st.get("done") or 0,
                    "total": st.get("total") or 0, "note": st.get("note") or "",
                    "files": files, "ok": bool(ok)})


