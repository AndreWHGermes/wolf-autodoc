            + '</div></div>'
            '<div class="doc-actions">'
            '<button type="button" class="doc-btn doc-view" data-pdf="' + pdf_name + '" '
            'data-tpl-id="' + str(t["id"]) + '" '
            + ('disabled style="opacity:.4;cursor:default"' if (not pdf_name and not has_original) else "")
            + ' title="Посмотреть здесь">👁</button>'
            '<a class="doc-btn" href="/applications/' + str(app_id) + '/doc/' + str(t["id"]) + '/editor" title="Редактировать переменные">\u270f\ufe0f</a>'
            '<a class="doc-btn" target="_blank" href="/templates/file/renders/' + pdf_name + '" '
            + ('style="opacity:.4;pointer-events:none"' if not pdf_name else "")
            + ' title="Открыть PDF в новой вкладке">\U0001f4c4</a>'
            '<button type="button" class="doc-btn ' + ok_btn_class + '" '
            'data-verify-app="' + str(app_id) + '" data-verify-tpl="' + str(t["id"]) + '" '
            'title="Отметить Ок">' + ok_btn_label + '</button>'
            '</div>'
            '</li>'
        )

    all_products = db.q("SELECT id, code, name FROM products ORDER BY id")
    product_select = ""
    if all_products:
        opts = "".join(
            '<option value="' + str(p["id"]) + '"'
            + (' selected' if p["id"] == a.get("product_id") else '')
            + '>' + p["name"] + ' (' + p["code"] + ')</option>'
            for p in all_products
        )
        product_select = (
            '<form method="post" action="/applications/' + str(app_id) + '/change-product" style="margin:6px 0 0">'
            '<select name="product_id" onchange="this.form.submit()" '
            'style="width:100%;padding:6px 8px;border:1px solid #DCEEE2;border-radius:6px;font-size:12.5px;background:#fff">'
            + opts + '</select>'
            '</form>'
        )

    drive_btn = (
        '<a href="' + drive_url + '" target="_blank" rel="noopener" class="drive-btn">'
        '📂 Google Drive клиента</a>'
        if drive_url else '<span class="muted" style="font-size:12.5px">ссылка не указана</span>'
    )

        # Продукт добавляем первым с жёлтой подсветкой
    extra_rows = []
    if product:
        extra_rows.append(
            '<tr class="kv-product-row"><td class="kv-key kv-key-product">'
            '<code>product</code></td>'
            '<td class="kv-val kv-val-product">' + product_label + ' '
            '<span class="kv-product-code">(' + product_code + ')</span></td></tr>'
        )
    elif a.get("product_id"):
        extra_rows.append(
            '<tr class="kv-product-row"><td class="kv-key kv-key-product">'
            '<code>product_id</code></td>'
            '<td class="kv-val kv-val-product">#' + str(a["product_id"]) + '</td></tr>'
        )
    if raw_payload_rows:
        _raw_payload_html = (
            '<table class="kv-table">'
            + ''.join(extra_rows)
            + ''.join('<tr><td class="kv-key"><code>' + k + '</code></td><td class="kv-val">' + v + '</td></tr>' for k, v in raw_payload_rows)
            + '</table>'
        )
    elif raw_payload_text or extra_rows:
        _raw_payload_html = (
            '<table class="kv-table">'
            + ''.join(extra_rows)
            + ('<tr><td colspan="2"><div class="raw-payload-text">' + raw_payload_text + '</div></td></tr>' if raw_payload_text else '')
            + '</table>'
        )
    else:
        _raw_payload_html = '<div class="muted">Нет данных</div>' 

    body = """
<div class="app-card-green">

<div class="app-head">
  <div class="app-head-left">
    <span class="app-head-id">Заявка #""" + str(app_id) + """</span>
    <span class="app-head-client">· """ + (db.client_label(client) or '—') + """</span>
    <span class="badge """ + status_label[1] + """">""" + status_label[0] + """</span>
  </div>
  <div class="app-head-right">
    <span class="from-label">👤 Откуда:</span>
    """ + manager_btn + """
