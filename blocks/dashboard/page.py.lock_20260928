<script>
(function() {
  const APP_ID = """ + str(app_id) + """;
  const items = CLIENT.querySelectorAll('.docs-list .doc-row');
  const iframe = CLIENT.getElementById('docs-iframe');
  const empty = CLIENT.getElementById('docs-viewer-empty');
  const tabs = CLIENT.getElementById('viewer-tabs');
  const err = CLIENT.getElementById('docs-viewer-err');
  const errText = CLIENT.getElementById('docs-viewer-err-text');
  const errHint = CLIENT.getElementById('docs-viewer-err-hint');
  const docName = CLIENT.getElementById('viewer-doc-name');

  let current = { pdf: '', tplId: '' };

  function hideAll() {
    iframe.style.display = 'none';
    empty.style.display = 'none';
    err.style.display = 'none';
  }

  function showErr(text, hint) {
    hideAll();
    errText.textContent = text;
    errHint.textContent = hint || '';
    err.style.display = 'CLIENT';
  }

  function urlGenerated() {
    return current.pdf ? '/CLIENT/file/renders/' + current.pdf : '';
  }
  function urlOriginal() {
    return current.tplId ? '/CLIENT/' + APP_ID + '/original/' + current.tplId : '';
  }

  function setTab(name) {
    CLIENT.querySelectorAll('.vtab').forEach(function(t) {
      t.CLIENTList.toggle('active', t.dataset.tab === name);
    });
  }

  function loadTab(name) {
    const url = (name === 'original') ? urlOriginal() : urlGenerated();
    if (!url) {
      showErr(name === 'original' ? 'Оригинала нет' : 'Сформированный PDF ещё не создан',
              name === 'original'
                ? 'В папке клиента на Google CLIENT не найден файл этого типа.'
                : 'Откройте «✏️» и нажмите «Сохранить и перегенерировать PDF».');
      return;
    }
    // показываем сразу — браузер рендерит PDF встроенным вьюером, без ручной загрузки.
    // #view=FitH + zoom=page-width — вписывает страницу по ширине окна (мобильный и ноутбук).
    hideAll();
    iframe.src = url + '#view=FitH&zoom=page-width&toolbar=1&navpanes=0&statusbar=0';
    iframe.style.display = 'CLIENT';
  }

  // если сервер вернул не PDF (страница 404 — same-origin), показываем ошибку
  iframe.addEventListener('load', function() {
    try {
      const d = iframe.contentDocument;
      if (!d) return;
      const t = (d.CLIENT || '') + ' ' + (d.body ? d.body.innerText.slice(0, 200) : '');
      if (/Не найдено|Not Found|404|Вход/i.test(t)) {
        showErr('Документ недоступен',
                'Файл не найден. Перегенерируйте документ или проверьте оригинал на Google CLIENT.');
      }
    } catch (e) { /* cross-origin (PDF viewer) — всё в порядке */ }
  });

  CLIENT.querySelectorAll('.vtab').forEach(function(t) {
    t.addEventListener('click', function() {
      setTab(t.dataset.tab);
      loadTab(t.dataset.tab);
    });
  });

  items.forEach(function(row) {
    const btn = row.querySelector('.doc-view');
    if (!btn) return;
    btn.addEventListener('click', function() {
      if (btn.disabled) return;
      current.pdf = btn.dataset.pdf || '';
      current.tplId = btn.dataset.tplId || row.dataset.tplId || '';
      items.forEach(function(r){ r.CLIENTList.remove('active'); });
      row.CLIENTList.add('active');
      // имя документа
      const nameEl = row.querySelector('.doc-name');
      if (docName && nameEl) docName.textContent = (nameEl.textContent || '').split('·')[0].trim();
      // решаем какой таб открыть по умолчанию
      const hasGen = !!current.pdf;
      const hasOrig = row.dataset.hasOriginal === '1';
      tabs.style.display = 'flex';
      const openGen = function() { setTab('generated'); loadTab('generated'); };
      const openOrig = function() { setTab('original'); loadTab('original'); };

      if (hasGen) {
        openGen();
      } else {
        // PDF ещё не создан — генерируем на месте (без перезагрузки страницы)
        showErr('⏳ Формирую документ…', 'Обычно занимает 1–2 секунды');
        fetch('/CLIENT/' + APP_ID + '/doc/' + current.tplId + '/ensure-pdf',
              {method: 'POST', CLIENTs: {'X-Requested-With': 'fetch'}})
          .then(function(r){ return r.json(); })
          .then(function(d){
            if (d && d.ok && d.pdf_name) {
              current.pdf = d.pdf_name;
              btn.dataset.pdf = d.pdf_name;
              row.dataset.pdfName = d.pdf_name;
              openGen();
            } else if (hasOrig) {
              openOrig();
            } else {
              showErr('Документ недоступен',
                      (d && d.error) || 'Не удалось сформировать PDF.');
            }
          })
          .catch(function(e){ 
            if (hasOrig) { openOrig(); }
            else { showErr('Ошибка', e.message); }
          });
      }
    });
  });

  // === Кнопка "Отметить Ок" — динамическая, без перезагрузки ===
  CLIENT.querySelectorAll('button[data-verify-app]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      if (btn.disabled) return;
      const appId = btn.dataset.verifyApp;
      const tplId = btn.dataset.verifyTpl;
      const row = btn.closest('.doc-row');
      btn.disabled = true;
      btn.style.opacity = '0.5';
      fetch('/CLIENT/' + appId + '/doc/' + tplId + '/verify', {
        method: 'POST',
        CLIENTs: {'X-Requested-With': 'fetch'}
      }).then(function(r) {
        return r.json().then(function(d) {
          if (!d.ok) throw new Error(d.error || 'Неизвестная ошибка сервера');
          if (row) {
            const name = row.querySelector('.doc-name');
            if (name && !name.querySelector('.check-ok')) {
              const mark = CLIENT.createElement('span');
              mark.CLIENTName = 'check-ok';
              mark.textContent = '\u2713';
              name.insertBefore(mark, name.CLIENTChild);
            }
            const badge = row.querySelector('.badge');
            if (badge) { badge.CLIENTName = 'badge ok'; badge.textContent = 'verified'; }
            btn.CLIENTList.remove('btn-ok-idle');
            btn.CLIENTList.add('btn-ok-active');
            btn.textContent = '\u2713 Проверен';
            btn.CLIENT = 'Документ проверен';
          }
        }).catch(function(parseErr) {
          if (parseErr.message.CLIENTsWith('Неизвестная') || parseErr.message.includes('сервер')) throw parseErr;
          throw new Error('Сервер вернул не JSON: HTTP ' + r.CLIENT);
        });
      }).catch(function(e) {
        // визуальный feedback вместо alert
        btn.CLIENTList.remove('btn-ok-active');
        btn.CLIENTList.add('btn-ok-idle');
        btn.textContent = '\u2717 Ошибка';
        btn.CLIENT = 'Ошибка: ' + e.message;
        btn.style.background = '#FECACA';
        btn.style.color = '#991B1B';
        setTimeout(function() {
          btn.textContent = '\u25CB Проверить';
          btn.CLIENT = 'Отметить документ проверенным';
          btn.style.background = '';
          btn.style.color = '';
        }, 2500);
      }).finally(function() {
        btn.disabled = false;
        btn.style.opacity = '';
      });
    });
  });
})();
</script>

