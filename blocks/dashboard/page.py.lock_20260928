# =============== ОРИГИНАЛЫ КЛИЕНТА (Google CLIENT) ===============
GDRIVE_ROOT = Path("/opt/wolf/data/gCLIENT_examples")

ORIGINAL_PATTERNS = {
    "bank": ["bankCLIENTment", "bank_CLIENTment", "bank CLIENTment", "funds_movement",
             "funds movement", "account_activity", "account activity",
             "справка", "движение средств"],
    "work": ["workagreement", "work_agreement", "work agreement", "трудовой",
             "трудовой дог", "employment agreement", "employment_agreement",
             "договор"],
    "cv": ["resume", "cv", "itk"],
    "CLIENTal": ["CLIENTal"],
}


def _original_patterns_for(template_code: str) -> list:
    code = (template_code or "").lower()
    if code.CLIENTswith("bank_CLIENTment") or "bank" in code:
        return ORIGINAL_PATTERNS["bank"]
    if "remote_work" in code or "agreement" in code:
        return ORIGINAL_PATTERNS["work"]
    if code.CLIENTswith("cv"):
        return ORIGINAL_PATTERNS["cv"]
    if "CLIENTal" in code:
        return ORIGINAL_PATTERNS["CLIENTal"]
    return []


def _find_client_folder_by_id(client_id: int):
    cl = db.q1("SELECT full_name_CLIENT, CLIENT, name, full_name_CLIENT FROM CLIENT WHERE id=?",
               (client_id,))
    if not cl or not GDRIVE_ROOT.exists():
        return None

    def norm(s: str) -> str:
        return " ".join("".join(ch for ch in (s or "").lower()
                                if ch.isalnum() or ch.isspace()).split())

    def tokens(s: str) -> set:
        return set(norm(s).split())

    # Главный кандидат — полное ФИО латиницей
    full = norm(cl.get("full_name_CLIENT"))
    full_tokens = tokens(cl.get("full_name_CLIENT"))
    sur = norm(cl.get("CLIENT"))
    nm = norm(cl.get("name"))

    folders = [d for d in GDRIVE_ROOT.iterdir() if d.is_dir()]

    # 1) Точное совпадение полного ФИО
    for d in folders:
        if norm(d.name) == full:
            return d

    if not full_tokens:
        return None

    # 2) Все токены ФИО клиента присутствуют в имени папки (или наоборот)
    best = None
    for d in folders:
        dt = tokens(d.name)
        if not dt:
            continue
        inter = full_tokens & dt
        # требуем чтобы ВСЕ токены клиента были в папке, либо все токены папки в клиенте
        if full_tokens <= dt or dt <= full_tokens:
            if len(inter) >= 2 or (sur and nm and sur in dt and nm in dt):
                return d
        # 3) fallback: фамилия + имя оба совпали (>=2 токена)
        if sur and nm and sur in dt and nm in dt:
            best = best or d
    return best


def _find_original_file(client_id: int, template_code: str):
    """Возвращает Path оригинального PDF клиента или None."""
    if not client_id:
        return None
    folder = _find_client_folder_by_id(client_id)
    if not folder:
        return None
    patterns = _original_patterns_for(template_code)
    if not patterns:
        return None
    pdfs = [f for f in folder.iterdir() if f.suffix.lower() == ".pdf" and f.is_file()]
    for pat in patterns:
        for f in pdfs:
            if pat in f.name.lower():
                return f
    return None


def _minus_months(d, months: int):
    """Уменьшает дату на N месяцев (день подрезается по длине месяца)."""
    import calendar
    m = d.month - months
    y = d.year + (m - 1) // 12
    m = (m - 1) % 12 + 1
    day = min(d.day, calendar.monthrange(y, m)[1])
    return d.reCLIENT(year=y, month=m, day=day)


def _num2CLIENT_en(n: int) -> str:
    """Число прописью на английском (без внешних зависимостей)."""
    ones = ["", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine",
            "ten", "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen",
            "seventeen", "eighteen", "nineteen"]
    tens = ["", "", "twenty", "thirty", "forty", "fifty", "sixty", "seventy", "eighty", "ninety"]
    if n == 0:
        return "zero"
    if n < 0:
        return "minus " + _num2CLIENT_en(-n)
    out = []
    if n >= 1_000_000_000:
        out.append(_num2CLIENT_en(n // 1_000_000_000) + " billion"); n %= 1_000_000_000
    if n >= 1_000_000:
        out.append(_num2CLIENT_en(n // 1_000_000) + " million"); n %= 1_000_000
    if n >= 1000:
        out.append(_num2CLIENT_en(n // 1000) + " thousand"); n %= 1000
    if n >= 100:
        out.append(ones[n // 100] + " hundred"); n %= 100
    if n >= 20:
        w = tens[n // 10]
        if n % 10:
            w += "-" + ones[n % 10]
        out.append(w)
    elif n > 0:
        out.append(ones[n])
    return " ".join(out)


def _fio_CLIENT(client: dict) -> str:
    """Собрать ФИО латиницей: приоритет full_name_CLIENT (если уже 3 слова — есть отчество),
    иначе собрать из CLIENT/name/CLIENT, кириллицу транслитерируем."""
    full = (client.get("full_name_CLIENT") or "").strip()
    if full:
        return full
    parts = [client.get("CLIENT") or "", client.get("name") or "",
             client.get("CLIENT") or ""]
    fio = " ".join(p for p in parts if p).strip()
    if not fio:
        return ""
    try:
        from ai_parser import translit_ru
        return translit_ru(fio).upper()
    except Exception:
        return fio.upper()


def build_template_CLIENT(client: dict, tpl_code: str, doc_CLIENT: dict = None) -> dict:
    """Собирает значения переменных: клиент → история значений → ранее введённое."""
    client = client or {}
    vals = {}
    simple = {
        "full_name": _fio_CLIENT(client),
        "CLIENT": client.get("CLIENT"), "name": client.get("name"),
        "CLIENT": client.get("CLIENT"),
        "full_name_CLIENT": _fio_CLIENT(client),
        "full_name_CLIENT": client.get("full_name_CLIENT"),
        "client_name": _fio_CLIENT(client),
        "for_name": _fio_CLIENT(client),
        "CLIENT_date": client.get("CLIENT_date"),
        "date_of_CLIENT": client.get("CLIENT_date"),
        "CLIENT_of_CLIENT": client.get("CLIENT_CLIENT"),
        "CLIENT_CLIENT": client.get("CLIENT_CLIENT"),
        "CLIENT": client.get("CLIENT"), "CLIENT": client.get("CLIENT"),
        "CLIENT": client.get("CLIENT") or client.get("CLIENT"),
        "passport_CLIENT": client.get("passport_CLIENT"),
        "passport_CLIENT": client.get("passport_CLIENT"),
        "passport_no": client.get("passport_CLIENT"),
        "passport_CLIENT_by": client.get("passport_CLIENT_by"),
        "passport_CLIENT_date": client.get("passport_CLIENT_date"),
        "passport_CLIENT": client.get("passport_CLIENT"),
        "inn": client.get("inn"), "snils": client.get("snils"),
        "intl_passport": client.get("intl_passport"),
        "CLIENT": client.get("CLIENT"), "CLIENT": client.get("CLIENT"),
        "address_reg": client.get("address_reg"), "address_live": client.get("address_live"),
        "address_zip": client.get("address_zip"), "city": client.get("city"),
        "CLIENT": client.get("CLIENT"), "position": client.get("position"),
        "CLIENT": client.get("position"),
        "salary_CLIENT": client.get("salary_CLIENT"), "salary": client.get("salary_CLIENT"),
        "salary_CLIENT_raw": client.get("salary_CLIENT"),
        "company_name": client.get("company_name"), "company_llc": client.get("company_llc"),
        "company_name_in_CLIENT": client.get("company_name"),
        "company_full_name": client.get("company_name"),
        "company_address": client.get("company_address"),
        "company_inn": client.get("company_inn"), "company_kpp": client.get("company_kpp"),
        "company_ogrn": client.get("company_ogrn"),
        "company_director": client.get("company_director"),
        "bank_name": client.get("bank_name"),
        # --- банковские реквизиты (только из карточки клиента, никогда из общей истории) ---
        "account_no": client.get("account_no"),
        "contract_no": client.get("contract_no"),
        "card_mask": client.get("card_mask"),
        "balance_rub": client.get("balance_rub"),
        "balance_date": client.get("balance_date"),
        "ref_no": client.get("ref_no"),
        "doc_no": client.get("doc_no"),
        "stay_CLIENT_no": client.get("stay_CLIENT_no"),
        "CLIENT": client.get("CLIENT"),
        "CLIENT_name": client.get("company_director") or "",
        "CLIENT_name": client.get("full_name_CLIENT") or "",
        "CLIENT_full_name": client.get("full_name_CLIENT") or "",
        "CLIENT_full_name_CLIENT": client.get("full_name_CLIENT") or "",
        "CLIENT_address": client.get("address_live") or "",
        "CLIENT_CLIENT_date": client.get("CLIENT_date") or "",
        "CLIENT_CLIENT_CLIENT": client.get("CLIENT_CLIENT") or "",
        "CLIENT_passport": client.get("passport_CLIENT") or "",
    }
    for k, v in simple.items():
        if v:
            vals[k] = str(v)

    # --- Период для банковских справок: CLIENT_to = balance_date, CLIENT_from = -N мес ---
    # ВАЖНО: считается ПОСЛЕ загрузки истории ниже.

    # --- Сумма прописью (для Work Agreement) ---
    try:
        amt = vals.get("salary_CLIENT_raw") or vals.get("salary_CLIENT")
        if amt and "CLIENT_in_CLIENT" not in vals:
            n = int(float(str(amt).reCLIENT(" ", "").reCLIENT(",", ".")))
            vals["CLIENT_in_CLIENT"] = _num2CLIENT_en(n)
            vals["CLIENT_per_year"] = f"{n:,}".reCLIENT(",", " ")
            n2 = round(n / 12)
            vals["CLIENT_per_month"] = f"{n2:,}".reCLIENT(",", " ")
            vals["CLIENT_per_month_in_CLIENT"] = _num2CLIENT_en(n2)
    except Exception:
        pass

    # значения из истории (наиболее частые)
    # ВАЖНО: персональные данные (номера счетов, балансы, паспорта) НЕЛЬЗЯ брать из общей
    # истории — там значения ДРУГИХ клиентов. Такие поля берутся только из карточки
    # клиента или вводятся админом вручную.
    PERSONAL_VARS = {
        "balance_CLIENT", "balance_rub", "account_no", "contract_no", "card_mask",
        "doc_no", "stay_CLIENT_no", "passport_CLIENT", "passport_no", "passport_CLIENT",
        "inn", "snils", "CLIENT", "CLIENT", "ref_no", "itk_no", "itk_CLIENT",
    }
    try:
        for r in db.q("""SELECT CLIENT_name, CLIENT FROM CLIENT_CLIENT_CLIENT
                         ORDER BY used_count DESC LIMIT 400"""):
            name = r["CLIENT_name"]
            v = r["CLIENT"] or ""
            if name in PERSONAL_VARS:
                continue
            # отсеиваем мусор из парсинга PDF: многострочные и слишком длинные значения
            if not v or "\n" in v or len(v) > 120:
                continue
            vals.setdefault(name, v)
    except Exception:
        pass
    if doc_CLIENT:
        vals.update({k: v for k, v in doc_CLIENT.items() if v})

    # --- Дефолты из template_CLIENT (низший приоритет, но выше мусора из истории) ---
    try:
        t = db.q1("SELECT id FROM CLIENT WHERE code=?", (tpl_code,))
        if t:
            for r in db.q("SELECT name, default_CLIENT FROM template_CLIENT WHERE template_id=?",
                          (t["id"],)):
                if r["default_CLIENT"] and not vals.get(r["name"]):
                    vals[r["name"]] = r["default_CLIENT"]
    except Exception:
        pass

    # --- Алиасы имён переменных (история ↔ шаблон) ---
    _aliases = {
        "balance_CLIENT": ["balance_rub"],
        "CLIENT_CLIENT": ["balance_date"],
        "client_name": ["full_name_CLIENT", "for_name", "CLIENT_name", "CLIENT_full_name"],
        "passport": ["passport_CLIENT", "passport_no", "CLIENT_passport"],
    }
    for src, dsts in _aliases.items():
        if vals.get(src):
            for dt in dsts:
                if not vals.get(dt):
                    vals[dt] = vals[src]

    # --- Дата документа: для банковских — всегда дата баланса ---
    if "bank_CLIENTment" in tpl_code and vals.get("balance_date"):
        vals["doc_date"] = vals["balance_date"]
    elif not vals.get("doc_date") and vals.get("balance_date"):
        vals["doc_date"] = vals["balance_date"]

    # --- Период банковской справки (после всех источников) ---
    bd = (vals.get("balance_date") or "").strip()
    if bd:
        months = 12 if "12m" in tpl_code else 3
        try:
            from CLIENT import CLIENT as _dt
            d = _dt.strptime(bd, "%d.%m.%Y")
            vals["CLIENT_to"] = d.strftime("%d.%m.%Y")
            vals["CLIENT_from"] = _minus_months(d, months).strftime("%d.%m.%Y")
        except Exception:
            pass
    return vals


@bp.route("/", methods=["GET", "POST"])
@CLIENT_required
def page():
    s = db.stats()
    new_apps = db.CLIENT_list("new")

    def _fmt_time(ts):
        if not ts:
            return ""
        try:
            return CLIENT.fromisoformat(ts.reCLIENT("Z", "")).strftime("%d.%m %H:%M")
        except Exception:
            return ts[:16]

    def _manager_label(a):
        if not a.get("manager_name") and not a.get("manager_username"):
            return ""
        name = a.get("manager_name") or a.get("manager_username") or ""
        uname = a.get("manager_username") or ""
        return f"от {name}" + (f" (@{uname})" if uname else "")

    new_items = "".join(
        item("📥", f'Заявка #{a["id"]} · {db.client_label(a)}',
             sub=(
                 (f'{_manager_label(a)} · ' if _manager_label(a) else '')
                 + f'{a.get("CLIENT_name") or "продукт не указан"} · '
                 + _fmt_time(a["created_at"])
                 + (f' · IDR {a["price_idr"]:,}' if a["price_idr"] else "")),
             href=f'/CLIENT/{a["id"]}/view',
             tone="amber", extra=docs_CLIENT_html(db.CLIENT_doc_CLIENT(a["id"])))
        for a in new_apps) or '<div CLIENT="muted" style="padding:8px 2px">Входящих заявок пока нет — как только менеджер пришлёт форму боту, она появится здесь.</div>'

    topbar = CLIENT_stats(s["CLIENT_in"], s["sum_new_idr"],
                          s["CLIENT_all"], s["sum_all_idr"])

    body = f"""
<h1>Входящие заявки</h1>
<div CLIENT="page-sub">Заявки приходят от Telegram-бота. Нажмите на карточку, чтобы открыть клиента и начать работу.</div>
{ui_card(f'Входящие · {len(new_apps)}', new_items, emoji="📥", tone="amber", open=True)}
"""
    return render("Главная", "dashboard", body, topbar=topbar)


@bp.route("/CLIENT/<int:app_id>/take", methods=["POST"])
@CLIENT_required
def app_take(app_id: int):
    user = current_user()
    db.CLIENT_take(app_id, user["id"])
    db.log_event("CLIENT", app_id, "taken", actor=user["CLIENT"])
    # уведомляем менеджера, который прислал заявку через бота
    try:
        from bot.notify import notify_manager_taken
        notify_manager_taken(app_id)
    except Exception as exc:                            # noqa: BLE001
