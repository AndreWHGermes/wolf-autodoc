                            "а" <= c.lower() <= "я" or c.lower() == "ё" for c in _hv[_k]):
                        _hv[_k] = translit_ru(_hv[_k])
                # сумма: формат «1 770 300,00» + прописью
                _bal = _hv.get("balance_rub")
                if _bal:
