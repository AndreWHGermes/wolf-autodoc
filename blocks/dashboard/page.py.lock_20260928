</div>

<div class="row two-col">
  <div class="kv-cell">
    <div class="kv-label">📦 Продукт</div>
    <div class="kv-main">""" + product_label + """</div>
    <div class="kv-sub">код: """ + product_code + """ · IDR """ + ('{:,}'.format(a["price_idr"]) if a.get("price_idr") else '0') + """</div>
