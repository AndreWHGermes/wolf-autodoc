# =============== ОРИГИНАЛЫ КЛИЕНТА (Google Drive) ===============
GDRIVE_ROOT = Path("/opt/wolf/data/gdrive_examples")

ORIGINAL_PATTERNS = {
    "bank": ["bankstatement", "bank_statement", "bank statement", "funds_movement",
             "funds movement", "account_activity", "account activity",
             "справка", "движение средств"],
    "work": ["workagreement", "work_agreement", "work agreement", "трудовой",
             "трудовой дог", "employment agreement", "employment_agreement",
             "договор"],
    "cv": ["resume", "cv", "itk"],
    "personal": ["personal"],
}


def _original_patterns_for(template_code: str) -> list:
    code = (template_code or "").lower()
    if code.startswith("bank_statement") or "bank" in code:
        return ORIGINAL_PATTERNS["bank"]
    if "remote_work" in code or "agreement" in code:
        return ORIGINAL_PATTERNS["work"]
    if code.startswith("cv"):
        return ORIGINAL_PATTERNS["cv"]
    if "personal" in code:
        return ORIGINAL_PATTERNS["personal"]
    return []


def _find_client_folder_by_id(client_id: int):
    cl = db.q1("SELECT full_name_latin, surname, name, full_name_title FROM clients WHERE id=?",
               (client_id,))
    if not cl or not GDRIVE_ROOT.exists():
        return None

    def norm(s: str) -> str:
        return " ".join("".join(ch for ch in (s or "").lower()
                                if ch.isalnum() or ch.isspace()).split())

    def tokens(s: str) -> set:
        return set(norm(s).split())

    # Главный кандидат — полное ФИО латиницей
    full = norm(cl.get("full_name_latin"))
    full_tokens = tokens(cl.get("full_name_latin"))
    sur = norm(cl.get("surname"))
    nm = norm(cl.get("name"))

    folders = [d for d in GDRIVE_ROOT.iterdir() if d.is_dir()]

    # 1) Точное совпадение полного ФИО
    for d in folders:
        if norm(d.name) == full:
            return d

    if not full_tokens:
        return None

    # 2) Все токены ФИО клиента присутствуют в имени папки (или наоборот)
    best = None
    for d in folders:
        dt = tokens(d.name)
        if not dt:
            continue
        inter = full_tokens & dt
        # требуем чтобы ВСЕ токены клиента были в папке, либо все токены папки в клиенте
        if full_tokens <= dt or dt <= full_tokens:
            if len(inter) >= 2 or (sur and nm and sur in dt and nm in dt):
                return d
        # 3) fallback: фамилия + имя оба совпали (>=2 токена)
        if sur and nm and sur in dt and nm in dt:
            best = best or d
    return best


def _find_original_file(client_id: int, template_code: str):
    """Возвращает Path оригинального PDF клиента или None."""
    if not client_id:
        return None
    folder = _find_client_folder_by_id(client_id)
    if not folder:
        return None
    patterns = _original_patterns_for(template_code)
    if not patterns:
        return None
    pdfs = [f for f in folder.iterdir() if f.suffix.lower() == ".pdf" and f.is_file()]
    for pat in patterns:
        for f in pdfs:
            if pat in f.name.lower():
                return f
    return None


def _minus_months(d, months: int):
    """Уменьшает дату на N месяцев (день подрезается по длине месяца)."""
    import calendar
    m = d.month - months
    y = d.year + (m - 1) // 12
    m = (m - 1) % 12 + 1
    day = min(d.day, calendar.monthrange(y, m)[1])
    return d.replace(year=y, month=m, day=day)


def _num2words_en(n: int) -> str:
    """Число прописью на английском (без внешних зависимостей)."""
    ones = ["", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine",
            "ten", "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen",
            "seventeen", "eighteen", "nineteen"]
    tens = ["", "", "twenty", "thirty", "forty", "fifty", "sixty", "seventy", "eighty", "ninety"]
    if n == 0:
        return "zero"
    if n < 0:
        return "minus " + _num2words_en(-n)
    out = []
    if n >= 1_000_000_000:
        out.append(_num2words_en(n // 1_000_000_000) + " billion"); n %= 1_000_000_000
    if n >= 1_000_000:
        out.append(_num2words_en(n // 1_000_000) + " million"); n %= 1_000_000
    if n >= 1000:
        out.append(_num2words_en(n // 1000) + " thousand"); n %= 1000
    if n >= 100:
        out.append(ones[n // 100] + " hundred"); n %= 100
    if n >= 20:
        w = tens[n // 10]
        if n % 10:
            w += "-" + ones[n % 10]
        out.append(w)
    elif n > 0:
        out.append(ones[n])
    return " ".join(out)


def _fio_latin(client: dict) -> str:
    """Собрать ФИО латиницей: приоритет full_name_latin (если уже 3 слова — есть отчество),
    иначе собрать из surname/name/patronymic, кириллицу транслитерируем."""
    full = (client.get("full_name_latin") or "").strip()
    if full:
        return full
    parts = [client.get("surname") or "", client.get("name") or "",
             client.get("patronymic") or ""]
    fio = " ".join(p for p in parts if p).strip()
    if not fio:
        return ""
    try:
        from ai_parser import translit_ru
        return translit_ru(fio).upper()
    except Exception:
        return fio.upper()


def build_template_values(client: dict, tpl_code: str, doc_values: dict = None) -> dict:
    """Собирает значения переменных: клиент → история значений → ранее введённое."""
    client = client or {}
    vals = {}
    simple = {
        "full_name": _fio_latin(client),
        "surname": client.get("surname"), "name": client.get("name"),
        "patronymic": client.get("patronymic"),
        "full_name_latin": _fio_latin(client),
        "full_name_title": client.get("full_name_title"),
        "client_name": _fio_latin(client),
        "for_name": _fio_latin(client),
        "birth_date": client.get("birth_date"),
        "date_of_birth": client.get("birth_date"),
        "place_of_birth": client.get("birth_place"),
        "birth_place": client.get("birth_place"),
        "gender": client.get("gender"), "citizenship": client.get("citizenship"),
        "nationality": client.get("nationality") or client.get("citizenship"),
        "passport_series": client.get("passport_series"),
        "passport_number": client.get("passport_number"),
        "passport_no": client.get("passport_number"),
        "passport_issued_by": client.get("passport_issued_by"),
        "passport_issue_date": client.get("passport_issue_date"),
        "passport_expiry": client.get("passport_expiry"),
        "inn": client.get("inn"), "snils": client.get("snils"),
        "intl_passport": client.get("intl_passport"),
        "phone": client.get("phone"), "email": client.get("email"),
        "address_reg": client.get("address_reg"), "address_live": client.get("address_live"),
        "address_zip": client.get("address_zip"), "city": client.get("city"),
        "country": client.get("country"), "position": client.get("position"),
        "profession": client.get("position"),
        "salary_amount": client.get("salary_amount"), "salary": client.get("salary_amount"),
        "salary_amount_raw": client.get("salary_amount"),
        "company_name": client.get("company_name"), "company_llc": client.get("company_llc"),
        "company_name_in_quotes": client.get("company_name"),
        "company_full_name": client.get("company_name"),
        "company_address": client.get("company_address"),
        "company_inn": client.get("company_inn"), "company_kpp": client.get("company_kpp"),
        "company_ogrn": client.get("company_ogrn"),
        "company_director": client.get("company_director"),
        "bank_name": client.get("bank_name"),
        # --- банковские реквизиты (только из карточки клиента, никогда из общей истории) ---
        "account_no": client.get("account_no"),
        "contract_no": client.get("contract_no"),
        "card_mask": client.get("card_mask"),
        "balance_rub": client.get("balance_rub"),
        "balance_date": client.get("balance_date"),
        "ref_no": client.get("ref_no"),
        "doc_no": client.get("doc_no"),
        "stay_permit_no": client.get("stay_permit_no"),
        "place": client.get("place"),
        "employer_name": client.get("company_director") or "",
        "employee_name": client.get("full_name_latin") or "",
        "employee_full_name": client.get("full_name_latin") or "",
        "employee_full_name_latin": client.get("full_name_latin") or "",
        "employee_address": client.get("address_live") or "",
        "employee_birth_date": client.get("birth_date") or "",
        "employee_birth_place": client.get("birth_place") or "",
        "employee_passport": client.get("passport_number") or "",
    }
    for k, v in simple.items():
        if v:
            vals[k] = str(v)

    # --- Период для банковских справок: period_to = balance_date, period_from = -N мес ---
    # ВАЖНО: считается ПОСЛЕ загрузки истории ниже.

    # --- Сумма прописью (для Work Agreement) ---
    try:
        amt = vals.get("salary_amount_raw") or vals.get("salary_amount")
        if amt and "amount_in_words" not in vals:
            n = int(float(str(amt).replace(" ", "").replace(",", ".")))
            vals["amount_in_words"] = _num2words_en(n)
            vals["amount_per_year"] = f"{n:,}".replace(",", " ")
            n2 = round(n / 12)
            vals["amount_per_month"] = f"{n2:,}".replace(",", " ")
            vals["amount_per_month_in_words"] = _num2words_en(n2)
    except Exception:
        pass

    # значения из истории (наиболее частые)
    # ВАЖНО: персональные данные (номера счетов, балансы, паспорта) НЕЛЬЗЯ брать из общей
    # истории — там значения ДРУГИХ клиентов. Такие поля берутся только из карточки
    # клиента или вводятся админом вручную.
    PERSONAL_VARS = {
        "balance_value", "balance_rub", "account_no", "contract_no", "card_mask",
        "doc_no", "stay_permit_no", "passport_number", "passport_no", "passport_series",
        "inn", "snils", "phone", "email", "ref_no", "itk_no", "itk_expiry",
    }
    try:
        for r in db.q("""SELECT variable_name, value FROM variable_value_history
                         ORDER BY used_count DESC LIMIT 400"""):
            name = r["variable_name"]
            v = r["value"] or ""
            if name in PERSONAL_VARS:
                continue
            # отсеиваем мусор из парсинга PDF: многострочные и слишком длинные значения
            if not v or "\n" in v or len(v) > 120:
                continue
            vals.setdefault(name, v)
    except Exception:
        pass
    if doc_values:
        vals.update({k: v for k, v in doc_values.items() if v})

    # --- Дефолты из template_variables (низший приоритет, но выше мусора из истории) ---
    try:
        t = db.q1("SELECT id FROM templates WHERE code=?", (tpl_code,))
        if t:
            for r in db.q("SELECT name, default_value FROM template_variables WHERE template_id=?",
                          (t["id"],)):
                if r["default_value"] and not vals.get(r["name"]):
                    vals[r["name"]] = r["default_value"]
    except Exception:
        pass

    # --- Алиасы имён переменных (история ↔ шаблон) ---
    _aliases = {
        "balance_value": ["balance_rub"],
        "period_dates": ["balance_date"],
        "client_name": ["full_name_latin", "for_name", "employee_name", "employee_full_name"],
        "passport": ["passport_number", "passport_no", "employee_passport"],
    }
    for src, dsts in _aliases.items():
        if vals.get(src):
            for dt in dsts:
                if not vals.get(dt):
                    vals[dt] = vals[src]

    # --- Дата документа: для банковских — всегда дата баланса ---
    if "bank_statement" in tpl_code and vals.get("balance_date"):
        vals["doc_date"] = vals["balance_date"]
    elif not vals.get("doc_date") and vals.get("balance_date"):
        vals["doc_date"] = vals["balance_date"]

    # --- Период банковской справки (после всех источников) ---
    bd = (vals.get("balance_date") or "").strip()
    if bd:
        months = 12 if "12m" in tpl_code else 3
        try:
            from datetime import datetime as _dt
            d = _dt.strptime(bd, "%d.%m.%Y")
            vals["period_to"] = d.strftime("%d.%m.%Y")
            vals["period_from"] = _minus_months(d, months).strftime("%d.%m.%Y")
        except Exception:
            pass
    return vals


@bp.route("/", methods=["GET", "POST"])
@login_required
def page():
    s = db.stats()
    new_apps = db.application_list("new")

    def _fmt_time(ts):
        if not ts:
            return ""
        try:
            return datetime.fromisoformat(ts.replace("Z", "")).strftime("%d.%m %H:%M")
        except Exception:
            return ts[:16]

    def _manager_label(a):
        if not a.get("manager_name") and not a.get("manager_username"):
            return ""
        name = a.get("manager_name") or a.get("manager_username") or ""
        uname = a.get("manager_username") or ""
        return f"от {name}" + (f" (@{uname})" if uname else "")

    new_items = "".join(
        item("📥", f'Заявка #{a["id"]} · {db.client_label(a)}',
             sub=(
                 (f'{_manager_label(a)} · ' if _manager_label(a) else '')
                 + f'{a.get("product_name") or "продукт не указан"} · '
                 + _fmt_time(a["created_at"])
                 + (f' · IDR {a["price_idr"]:,}' if a["price_idr"] else "")),
             href=f'/applications/{a["id"]}/view',
             tone="amber", extra=docs_state_html(db.application_doc_summary(a["id"])))
        for a in new_apps) or '<div class="muted" style="padding:8px 2px">Входящих заявок пока нет — как только менеджер пришлёт форму боту, она появится здесь.</div>'

    topbar = header_stats(s["applications_in"], s["sum_new_idr"],
                          s["applications_all"], s["sum_all_idr"])

    body = f"""
<h1>Входящие заявки</h1>
<div class="page-sub">Заявки приходят от Telegram-бота. Нажмите на карточку, чтобы открыть клиента и начать работу.</div>
{ui_card(f'Входящие · {len(new_apps)}', new_items, emoji="📥", tone="amber", open=True)}
"""
    return render("Главная", "dashboard", body, topbar=topbar)


@bp.route("/applications/<int:app_id>/take", methods=["POST"])
@login_required
def app_take(app_id: int):
    user = current_user()
    db.application_take(app_id, user["id"])
    db.log_event("application", app_id, "taken", actor=user["login"])
    # уведомляем менеджера, который прислал заявку через бота
    try:
        from bot.notify import notify_manager_taken
        notify_manager_taken(app_id)
    except Exception as exc:                            # noqa: BLE001
        current_app.logger.warning("notify_manager_taken failed: %s", exc)
    return redirect(url_for("dashboard.app_view", app_id=app_id))


@bp.route("/applications/<int:app_id>/change-product", methods=["POST"])
@login_required
def app_change_product(app_id: int):
    """Смена продукта администратором. Пересоздаёт application_documents."""
    from flask import request
    new_pid = request.form.get("product_id", type=int)
    if not new_pid:
        flash("Не выбран продукт", "error")
        return redirect(url_for("dashboard.app_view", app_id=app_id))
    # обновляем заявку
    prod = db.q1("SELECT id, code, name, description FROM products WHERE id=?", (new_pid,))
    if not prod:
        flash("Продукт не найден", "error")
        return redirect(url_for("dashboard.app_view", app_id=app_id))
    # вытащим price_idr из description или 0
    new_price = 0
    if prod.get("description"):
        import re as _re
        m = _re.search(r"price_idr\s*=\s*(\d+)", prod["description"])
        if m:
            new_price = int(m.group(1))
    db.exec_sql("UPDATE applications SET product_id=?, price_idr=? WHERE id=?",
              (prod["id"], new_price, app_id))
    # Удаляем старые application_documents и создаём новые под новый продукт
    db.exec_sql("DELETE FROM application_documents WHERE application_id=?", (app_id,))
    new_templates = db.q(
        """SELECT t.id, t.code, t.title FROM product_documents pd
              JOIN templates t ON t.id=pd.template_id
              WHERE pd.product_id=? ORDER BY t.id""",
        (new_pid,))
    import datetime as _dt
    now = _dt.datetime.now().isoformat(timespec="seconds")
    for t in new_templates:
        db.exec_sql(
            "INSERT INTO application_documents (application_id, template_id, status, rendered_at) "
            "VALUES (?, ?, 'pending', ?)",
            (app_id, t["id"], now))
    db.log_event("application", app_id, "product_changed", actor=current_user()["login"],
                 payload=json.dumps({"new_product": prod["code"]}, ensure_ascii=False))
    flash(f"Продукт изменён: {prod['name']}. Список документов обновлён.", "ok")
    return redirect(url_for("dashboard.app_view", app_id=app_id))


@bp.route("/applications/<int:app_id>/view")
@login_required
def app_view(app_id: int):
    a = db.application_get(app_id)
    if not a:
        flash("Заявка не найдена", "error")
        return redirect(url_for("dashboard.page"))
    # Автоматический take убран — заявка остаётся "new" во входящих,
    # пока админ сам не нажмёт "Взять в работу"
    a = db.application_get(app_id)

    client = db.client_get(a["client_id"]) or {}
    client_id_for_originals = a["client_id"]
    docs = db.application_documents(app_id)
    summary = db.application_documents_summary(app_id) if hasattr(db, 'application_documents_summary') else None

    # === АВТО-ГЕНЕРАЦИЯ PDF для всех pending-документов этой заявки ===
    # Срабатывает один раз: если у документа status='pending' и нет PDF — генерируем сразу
    pending_docs = [d for d in docs if d["status"] == "pending" and not d.get("pdf_path")]
    if pending_docs:
        try:
            from core import pdf2html as _pdf2html
            _cli = db.client_get(a["client_id"]) or {}
            for _pd in pending_docs:
                _tpl = db.q1("SELECT * FROM templates WHERE id=?", (_pd["template_id"],))
                if not _tpl:
                    continue
                _html_path = Path('/opt/wolf/data/templates') / _tpl["code"] / "template.html"
                if not _html_path.exists():
                    continue
                # дефолтные значения шаблона
                _vals = {}
                if _tpl.get("default_values_json"):
                    try: _vals = json.loads(_tpl["default_values_json"])
                    except: pass
                # подставим из клиента
                for _k in ("full_name_latin", "client_name", "name", "surname", "patronymic",
                           "address_live", "address_registration", "inn", "phone", "email"):
                    if not _vals.get(_k):
                        _vals[_k] = _cli.get(_k) or _cli.get(_k.replace("_live", "_reg")) or ""
                # подставим из raw_payload (bank_name)
                try:
                    _rp = json.loads(a["raw_payload"]) if a.get("raw_payload") else {}
                    for _k in ("bank_name", "bank", "profession", "salary_amount"):
                        if not _vals.get(_k) and _rp.get(_k):
                            _vals[_k] = str(_rp[_k])
                except: pass
                _html = _html_path.read_text(encoding="utf-8")
                _filled = re.sub(r"\{\{\s*([a-zA-Z0-9_]+)\s*\}\}",
                                 lambda m: str(_vals.get(m.group(1)) or m.group(0)), _html)
                _tmp = _html_path.parent / "filled.html"
                _tmp.write_text(_filled, encoding="utf-8")
                _out = Path('/opt/wolf/data/renders') / (_tpl["code"] + "_app" + str(app_id) + "_" + datetime.now().strftime("%Y%m%d_%H%M%S_%f") + ".pdf")
                _pdf2html.render_pdf(_tmp, _out)
                db.exec_sql(
                    "UPDATE application_documents SET pdf_path=?, status='filled', rendered_at=datetime('now') WHERE id=?",
                    (str(_out), _pd["id"]))
            # обновим docs после генерации
            docs = db.application_documents(app_id)
            flash("Документы автоматически сформированы — можно смотреть", "ok")
        except Exception as _exc:
            flash(f"Авто-генерация: {_exc}", "warning")

    status_label = {"new": ("новая", "amber"), "in_progress": ("в работе", "blue"),
                    "ready": ("готова", "ok"), "sent": ("отправлена", "ok"),
                    "closed": ("закрыта", "muted"), "error": ("ошибка", "bad")}.get(
                        a["status"], (a["status"], ""))

    manager = db.q1(
        """SELECT bm.telegram_id, bm.full_name, bm.username
             FROM bot_managers bm WHERE bm.id=?""",
        (a["bot_manager_id"],)) if a.get("bot_manager_id") else None
    manager_label = "—"
    if manager:
        m_name = manager["full_name"] or manager["username"] or manager["telegram_id"]
        manager_label = m_name + ((" (@" + manager["username"] + ")") if manager["username"] else "")
    manager_tg_url = ""
    if manager:
        if manager.get("username"):
            manager_tg_url = "https://t.me/" + manager["username"]
        elif manager.get("telegram_id"):
            manager_tg_url = "https://t.me/id" + str(manager["telegram_id"])
    manager_btn = ""
    if manager and manager_tg_url:
        manager_btn = (
            '<a class="from-write-btn" target="_blank" rel="noopener" '
            'href="' + manager_tg_url + '" title="Написать менеджеру в Telegram">'
            '✉️ ' + manager_label + '</a>'
        )
    else:
        manager_btn = '<span class="from-value">' + manager_label + '</span>'

    product = db.q1("SELECT name, code FROM products WHERE id=?", (a["product_id"],)) if a.get("product_id") else None
